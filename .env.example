# 这是本地配置模板，严禁填入真实凭证。

# Non-Compose development options (not consumed by compose.yaml).
OPENAI_API_KEY=
VITE_API_BASE_URL=http://localhost:8000
VITE_DATA_MODE=mock
# For direct backend development, copy these commented options into backend/.env:
# APP_ENV=development
# LOG_LEVEL=INFO
# DATABASE_URL=

# Compose local deployment placeholders; keep POSTGRES_PASSWORD and DATABASE_URL
# synchronized. The placeholder password is URL-safe and must be replaced before use.
POSTGRES_DB=crypto_research
POSTGRES_USER=crypto_research
POSTGRES_PASSWORD=replace-before-starting
DATABASE_URL=postgresql+asyncpg://crypto_research:replace-before-starting@postgres:5432/crypto_research
# Host-only pytest connection. Keep it separate from DATABASE_URL; the test
# fixture creates and removes temporary schemas in this database only.
TEST_DATABASE_URL=postgresql+asyncpg://crypto_research:replace-before-starting@127.0.0.1:5433/crypto_research_test
APP_ENV=production
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://localhost:8080"]
